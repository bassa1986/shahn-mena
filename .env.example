# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored, keep it that way.

# Neon Postgres connection string (used by the Next.js app and all scripts/scrapers)
DATABASE_URL=

# Public site URL, used for metadataBase / OpenGraph / sitemap
NEXT_PUBLIC_SITE_URL=https://shahn-mena.vercel.app

# Used by scripts/scrapers/articles-generator.js
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Used by scripts/scrapers/charging-scraper.js
OPENCHARGEMAP_API_KEY=
